rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    match /users/{userId} {

      // A user can read their own doc; the hardcoded admin email can read/list all docs.
      allow read: if request.auth != null
        && (request.auth.uid == userId
            || request.auth.token.email == 'keshav.karn@gmail.com');

      // Created once, by the owning user, with role derived from their verified email
      // (never from client input) and no extra fields.
      allow create: if request.auth != null
        && request.auth.uid == userId
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.role ==
             (request.auth.token.email == 'keshav.karn@gmail.com' ? 'admin' : 'user')
        && request.resource.data.keys().hasAll(
             ['email', 'displayName', 'photoURL', 'role', 'createdAt', 'lastLogin'])
        && request.resource.data.keys().hasOnly(
             ['email', 'displayName', 'photoURL', 'role', 'createdAt', 'lastLogin']);

      // Subsequent sign-ins may only touch lastLogin - role/email/etc. are immutable.
      allow update: if request.auth != null
        && request.auth.uid == userId
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['lastLogin']);

      allow delete: if false;
    }
  }
}
