rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    match /users/{userId} {

      // (1) own doc read, (4) admin email can read all docs
      allow read: if request.auth != null
        && (request.auth.uid == userId
            || request.auth.token.email == 'keshav.karn@gmail.com');

      // (2) role set only on create, derived from the caller's verified email
      allow create: if request.auth != null
        && request.auth.uid == userId
        && request.resource.data.role ==
             (request.auth.token.email == 'keshav.karn@gmail.com' ? 'admin' : 'user');

      // (3) update may only touch lastLogin - role (and everything else) is immutable
      allow update: if request.auth != null
        && request.auth.uid == userId
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['lastLogin']);

      // (5) no client-side deletes
      allow delete: if false;
    }
  }
}
